{
    "name": "imc/user-access-management-api",
    "description": "REST API Backend for User Access Management using Slim 4 and PostgreSQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "firebase/php-jwt": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8080 public/index.php",
        "serve": "php -S 0.0.0.0:8080 public/index.php",
        "migrate": "php database/migrate.php"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
