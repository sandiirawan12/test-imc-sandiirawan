{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist/frontend",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://test-imc-sandiirawan-production.up.railway.app/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
